<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="modern_ev">
    <physics name="1ms" type="ignored">
      <max_step_size>0.01</max_step_size> <real_time_factor>1.0</real_time_factor>
    </physics>
    <!-- fizik hesaplamalarını yapar -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <!-- kullanıcı komutlarını işler -->
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <!-- dinyadaki tüm nesneleri yayınlar -->
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- sensörleri simüle eder ve görselleştirir -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine> 
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="dis_duvarlar">
      <static>true</static>
      <link name="wall">
        <collision name="front"><pose>5 0 0.5 0 0 0</pose><geometry><box><size>0.1 10 1</size></box></geometry></collision>
        <visual name="front_v"><pose>5 0 0.5 0 0 0</pose><geometry><box><size>0.1 10 1</size></box></geometry></visual>
        <collision name="back"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.1 10 1</size></box></geometry></collision>
        <visual name="back_v"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.1 10 1</size></box></geometry></visual>
        <collision name="left"><pose>0 5 0.5 0 0 1.57</pose><geometry><box><size>0.1 10 1</size></box></geometry></collision>
        <visual name="left_v"><pose>0 5 0.5 0 0 1.57</pose><geometry><box><size>0.1 10 1</size></box></geometry></visual>
        <collision name="right"><pose>0 -5 0.5 0 0 1.57</pose><geometry><box><size>0.1 10 1</size></box></geometry></collision>
        <visual name="right_v"><pose>0 -5 0.5 0 0 1.57</pose><geometry><box><size>0.1 10 1</size></box></geometry></visual>
      </link>
    </model>

    <model name="masa">
      <static>true</static>
      <pose>2 1 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1 1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1 1 0.5</size></box></geometry><material><ambient>0 0 0.8 1</ambient></material></visual>
      </link>
    </model>
  </world>
</sdf>